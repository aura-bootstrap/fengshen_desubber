# desub:cu124-paddle — cu124 检测栈 + PaddleOCR（检测侧升级实验镜像）
# 构建（宿主 Git Bash）：
#   MSYS2_ARG_CONV_EXCL='*' docker build -f docker/Dockerfile.paddle -t desub:cu124-paddle \
#     --build-arg HTTP_PROXY=http://host.docker.internal:7897 \
#     --build-arg HTTPS_PROXY=http://host.docker.internal:7897 W:/QoderCN/desub-lab
# 使用：DESUB_IMAGE=desub:cu124-paddle bash scripts/run_container.sh remove ... --ocr --ocr-script /src/scripts/ocr_paddle.py
FROM desub:cu124
ARG HTTP_PROXY
ARG HTTPS_PROXY
RUN pip3 install --no-cache-dir paddlepaddle paddleocr
